# Build artifacts (regenerated by cmake --build)
build/
*.obj
*.o
*.exe

# Drive / test run logs (regenerated each run)
runtime_data/ctrl_log_*.csv
runtime_data/steer_trace_*.csv
runtime_data/loc_test_*.csv
runtime_data/trajectory_data.csv
runtime_data/trajectory_data.json
runtime_data/localized_pose.txt
runtime_data/launch_log*.txt
runtime_data/launch_test*.txt
runtime_data/pedestrian_status.txt

# MinGW runtime DLLs (bundled into runtime_data/ by the CMake build step)
runtime_data/libgcc_s_seh-1.dll
runtime_data/libgomp-1.dll
runtime_data/libstdc++-6.dll
runtime_data/libwinpthread-1.dll

# LaTeX build artifacts (thesis_project_V0.1 — sources and final PDFs stay tracked)
thesis_project_V0.1/*.aux
thesis_project_V0.1/*.log
thesis_project_V0.1/*.out
thesis_project_V0.1/*.toc
thesis_project_V0.1/*.lof
thesis_project_V0.1/*.lot
thesis_project_V0.1/*.bbl
thesis_project_V0.1/*.blg
thesis_project_V0.1/*.synctex.gz

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# Python caches
__pycache__/
*.pyc
